# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Sanity (from sanity.io/manage -> your project)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# The site's public address – used for SEO links, sitemap and WhatsApp product links.
# e.g. https://gns-website.netlify.app (later your real domain)
NEXT_PUBLIC_SITE_URL=

# Contact form emails (Resend – resend.com). Server-only, never NEXT_PUBLIC.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional until the domain is verified in Resend:
CONTACT_FROM_EMAIL=

# Added in Phase 4
# SANITY_REVALIDATE_SECRET=    # webhook secret for instant updates
# TURNSTILE_SECRET_KEY=        # contact form spam check
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
